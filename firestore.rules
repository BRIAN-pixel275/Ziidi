rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Live NSE prices: anyone signed in can read; only Cloud Functions
    // (Admin SDK, which bypasses these rules) can write.
    match /stockPrices/{ticker} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /_meta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Each user can only read/write their own investments.
    match /users/{userId}/investments/{investmentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
